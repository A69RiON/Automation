# eBay Developer Program production keys (store real values as GitHub Actions secrets)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional: pipe-separated discovery queries. Defaults are built in.
EBAY_SEARCH_QUERIES=black friday|clearance|deal|sale|laptop|ssd|monitor|graphics card|router|headphones|phone|tablet|tv|vacuum|gaming|camera

# Phase 4: Discord webhook will be read from a GitHub Actions secret, never committed.
DISCORD_WEBHOOK_URL=
